# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_analysis
DB_USER=postgres
DB_PASSWORD=your_password_here

# Data Extraction Settings
# Japanese stock symbols (Tokyo Stock Exchange)
JAPANESE_SYMBOLS=7203.T,6758.T,8306.T,9984.T,6861.T
# Korean stock symbols (Korea Exchange)
KOREAN_SYMBOLS=005930.KS,000660.KS,035720.KS,051910.KS,035420.KS

# Data refresh intervals (in minutes)
DAILY_REFRESH_INTERVAL=1440
INTRADAY_REFRESH_INTERVAL=5

# ML Monitoring Settings
VOLATILITY_THRESHOLD=0.05
VOLATILITY_WINDOW=20
